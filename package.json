{
  "name": "lulumails-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "sdk"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=sdk && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend"
  }
}
